<?xml version="1.0" encoding="utf-8"?>
<!-- Repository-local NuGet configuration. Clears machine/user-level feeds so restore is reproducible
     locally, in CI and in Docker, and satisfies central package management (NU1507). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
