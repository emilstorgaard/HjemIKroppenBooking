{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "HjemIKroppenBooking",
    "Audience": "HjemIKroppenBooking",
    "ExpiryHours": 12
  },
  "PasswordHashing": {
    "WorkFactor": 12
  },
  "RateLimiting": {
    "GlobalPermitLimitPerMinute": 300,
    "AuthPermitLimitPerMinute": 10
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "OpenApi": {
    "Enabled": false
  }
}
