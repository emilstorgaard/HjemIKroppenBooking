# Copy to .env (never commit .env) and replace every value. docker compose refuses to start while one is missing.

# SQL Server connection string. The server runs in its own container on proxy-net, so use its container name as host.
DB_CONNECTION_STRING=Server=sqlserver,1433;Database=HjemIKroppenBookingDb;User Id=booking_app;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True

# The frontend origin allowed by CORS: scheme and host only, no path and no trailing slash.
ALLOWED_ORIGIN=https://booking.example.dk

# The Umbraco backoffice origin, also allowed by CORS: its category picker reads the categories from the API.
UMBRACO_ORIGIN=https://cms.example.dk

# JWT signing key, at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_KEY=CHANGE_ME_TO_A_RANDOM_KEY_OF_AT_LEAST_32_BYTES

# Subnet of proxy-net (the reverse proxy's network) in CIDR form. Find it with: docker network inspect proxy-net
TRUSTED_PROXY_NETWORK=172.18.0.0/16
